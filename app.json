{
  "expo": {
    "name": "Finia",
    "slug": "app-financas",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "appfinancas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.erickalmeida.financas",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos o Face ID para proteger seus dados financeiros."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.erickalmeida.financas",
      "adaptiveIcon": {
        "backgroundColor": "#0E4A5C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": false
      },
      "eas": {
        "projectId": "2adf7ddf-43dc-477b-8a91-9436bb564551"
      }
    },
    "owner": "erick0303"
  }
}
